# Database Configuration
DATABASE_URL=sqlite:///./careerfit.db
# For PostgreSQL production:
# DATABASE_URL=postgresql://user:password@localhost:5432/careerfit_db

# Security & Authentication
JWT_SECRET=replace_this_with_a_secure_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth 2.0 Credentials (from Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Server & CORS Settings
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "https://yourdomain.com"]
MAX_UPLOAD_SIZE_MB=10
ENVIRONMENT=development
