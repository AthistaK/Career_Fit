# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://careerpath_user:careerpath_password@localhost:5432/careerpath_db

# Security & Authentication
JWT_SECRET=careerpath_super_secure_jwt_secret_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=
